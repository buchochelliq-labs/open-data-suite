s\".\"main\".\"stg_payments\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.476044Z", "completed_at": "2026-09-25T00:02:40.484140Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.485411Z", "completed_at": "2026-09-25T00:02:40.485428Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.01248478889465332, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.jaffle_ods.order_events", "compiled": true, "compiled_code": "select order_id, order_date as event_date, 'ordered' as event_type\nfrom \"jaffle_ods\".\"main\".\"stg_orders\"\nunion all\nselect order_id, cast(null as date) as event_date, 'paid' as event_type\nfrom \"jaffle_ods\".\"main\".\"stg_payments\"", "relation_name": "\"jaffle_ods\".\"main\".\"order_events\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.479750Z", "completed_at": "2026-09-25T00:02:40.484819Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.486322Z", "completed_at": "2026-09-25T00:02:40.486338Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.012721061706542969, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.jaffle_ods.orders", "compiled": true, "compiled_code": "\n\nwith payments as (\n    select\n        order_id,\n        sum(case when payment_method = 'credit_card' then amount else 0 end) as credit_card_amount,\n        sum(case when payment_method = 'coupon' then amount else 0 end) as coupon_amount,\n        sum(case when payment_method = 'bank_transfer' then amount else 0 end) as bank_transfer_amount,\n        sum(case when payment_method = 'gift_card' then amount else 0 end) as gift_card_amount,\n        sum(amount) as total_amount\n    from \"jaffle_ods\".\"main\".\"stg_payments\"\n    group by order_id\n)\n\nselect\n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    o.status,\n    p.credit_card_amount,\n    p.coupon_amount,\n    p.bank_transfer_amount,\n    p.gift_card_amount,\n    coalesce(p.total_amount, 0) as amount\nfrom \"jaffle_ods\".\"main\".\"stg_orders\" as o\nleft join payments as p on o.order_id = p.order_id", "relation_name": "\"jaffle_ods\".\"main\".\"orders\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.490477Z", "completed_at": "2026-09-25T00:02:40.496879Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.499725Z", "completed_at": "2026-09-25T00:02:40.499745Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.011067390441894531, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.jaffle_ods.customer_order_rank", "compiled": true, "compiled_code": "select\n    order_id,\n    customer_id,\n    amount,\n    row_number() over (partition by customer_id order by order_date) as order_seq,\n    sum(amount) over (partition by customer_id order by order_date) as running_amount\nfrom \"jaffle_ods\".\"main\".\"orders\"\nwhere status in ('completed', 'shipped')", "relation_name": "\"jaffle_ods\".\"main\".\"customer_order_rank\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.500769Z", "completed_at": "2026-09-25T00:02:40.595004Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.595675Z", "completed_at": "2026-09-25T00:02:40.595687Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.10152459144592285, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.jaffle_ods.customers", "compiled": true, "compiled_code": "with order_stats as (\n    select\n        customer_id,\n        min(order_date) as first_order,\n        max(order_date) as most_recent_order,\n        count(order_id) as number_of_orders,\n        sum(amount) as lifetime_value\n    from \"jaffle_ods\".\"main\".\"orders\"\n    where status <> 'returned'\n    group by customer_id\n)\n\nselect\n    c.customer_id,\n    c.first_name,\n    c.last_name,\n    c.first_name || ' ' || c.last_name as full_name,\n    s.first_order,\n    s.most_recent_order,\n    coalesce(s.number_of_orders, 0) as number_of_orders,\n    coalesce(s.lifetime_value, 0) as lifetime_value,\n    case when s.lifetime_value >= 20 then 'high' else 'standard' end as value_tier\nfrom \"jaffle_ods\".\"main\".\"stg_customers\" as c\nleft join order_stats as s using (customer_id)", "relation_name": "\"jaffle_ods\".\"main\".\"customers\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.504046Z", "completed_at": "2026-09-25T00:02:40.596543Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.597676Z", "completed_at": "2026-09-25T00:02:40.597702Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.10235166549682617, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.jaffle_ods.not_null_orders_order_id.cf6c17daed", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect order_id\nfrom \"jaffle_ods\".\"main\".\"orders\"\nwhere order_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T00:02:40.509509Z", "completed_at": "2026-09-25T00:02:40.601445Z"}, {"name": "execute", "started_at": "2026-09-25T00:02:40.605246Z", "completed_at": "2026-09-25T00:02:40.605263Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.10908246040344238, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.jaffle_ods.unique_orders_order_id.fed79b3a6e", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_id as unique_field,\n    count(*) as n_records\n\nfrom \"jaffle_ods\".\"main\".\"orders\"\nwhere order_id is not null\ngroup by order_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2