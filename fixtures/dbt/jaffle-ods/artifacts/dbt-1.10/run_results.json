r)", "execution_time": 0.035709381103515625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.jaffle_ods.payment_totals", "compiled": true, "compiled_code": "-- An incremental model (#435): each run adds the payments it hasn't seen yet, by id.\n-- It is off the stg_orders path the docs demo edits.\n\n\nselect\n    payment_id,\n    order_id,\n    payment_method,\n    amount\nfrom \"jaffle_ods\".\"main\".\"stg_payments\"\n\nwhere payment_id > (select coalesce(max(payment_id), 0) from \"jaffle_ods\".\"main\".\"payment_totals\")\n", "relation_name": "\"jaffle_ods\".\"main\".\"payment_totals\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T06:55:01.680937Z", "completed_at": "2026-09-25T06:55:01.698558Z"}, {"name": "execute", "started_at": "2026-09-25T06:55:01.705647Z", "completed_at": "2026-09-25T06:55:01.705665Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.03957557678222656, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.jaffle_ods.not_null_stg_payments_payment_id.c19cc50075", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect payment_id\nfrom \"jaffle_ods\".\"main\".\"stg_payments\"\nwhere payment_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-25T06:55:01.686405Z", "completed_at": "2026-09-25T06:55:01.704573Z"}, {"name": "execute", "started_at": "2026-09-25T06:55:01.707800Z", "completed_at": "2026-09-25T06:55:01.707818Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.03992891311645508, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.jaffle_ods.relationships_stg_payments_order_id__order_id__ref_stg_orders_.8426a3f3d3", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select order_id as from_field\n    from \"jaffle_ods\".\"main\".\"stg_payments\"\n    where order_id is not