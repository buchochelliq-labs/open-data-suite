<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ODS third-party licences</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    pre { white-space: pre-wrap; background: #f6f6f6; padding: 1rem; }
    .licence { border-top: 1px solid #ccc; margin-top: 2rem; }
  </style>
</head>
<body>
  <h1>Third-party licences</h1>
  <p>The <code>ods</code> binary (OpenDataSuite) is licensed under Apache-2.0: see LICENSE.
  It includes the third-party software listed below, under these licences.
  This file is generated by <a href="https://github.com/EmbarkStudios/cargo-about">cargo-about</a>.</p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  {{#each licenses}}
  <div class="licence">
    <h3 id="{{id}}">{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </div>
  {{/each}}
</body>
</html>
