# Installs `ods` from the GitHub release archive, checked against the release's SHA256SUMS.
# Rendered by rab (rab.yml, `chocolatey`) from
# packaging/chocolatey/tools/chocolateyinstall.ps1.tmpl in open-data-suite; edit that.
$ErrorActionPreference = 'Stop'

$toolsDir = Split-Path -Parent $MyInvocation.MyCommand.Definition

# Chocolatey puts a shim for every .exe under the package folder on PATH, so unzipping
# the release archive here is the whole install, and uninstalling removes it.
$packageArgs = @{
  packageName    = $env:ChocolateyPackageName
  unzipLocation  = $toolsDir
  url64bit       = '${url_x86_64_pc_windows_msvc}'
  checksum64     = '${sha256_x86_64_pc_windows_msvc}'
  checksumType64 = 'sha256'
}
Install-ChocolateyZipPackage @packageArgs
